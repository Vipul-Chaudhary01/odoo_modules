<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inherit_keyboard_shortcuts" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.ps.shortcuts</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']/div[contains(@class, 'o_settings_container')]" position="inside">
                <setting string="Keyboard Shortcuts" help="Enable configurable keyboard shortcuts in the POS interface">
                    <field name="keyboard_shortcut_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
