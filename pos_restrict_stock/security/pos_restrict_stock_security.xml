<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_pos_restrict_stock" model="ir.module.category">
        <field name="name">POS Stock Control</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_pos_restrict_stock" model="res.groups.privilege">
        <field name="name">POS Stock Control</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_pos_restrict_stock"/>
    </record>

    <record id="group_pos_stock_override" model="res.groups">
        <field name="name">Stock Override</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_restrict_stock"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="point_of_sale.group_pos_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('pos_restrict_stock.group_pos_stock_override'))]"/>
    </record>
</odoo>
