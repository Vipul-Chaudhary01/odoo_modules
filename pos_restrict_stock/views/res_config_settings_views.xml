<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_restrict_stock" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.restrict.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']/setting[@id='update_quantities_stock_setting']"
                   position="before">
                <setting id="pos_stock_control_setting" string="POS Stock Control"
                         help="Show stock in POS and block products that are unavailable in the POS source location.">
                    <field name="pos_display_stock"/>
                    <div class="content-group mt16">
                        <div>
                            <field name="pos_restrict_out_of_stock"/>
                            <label for="pos_restrict_out_of_stock" class="fw-normal ms-1"/>
                        </div>
                        <div class="mt8" invisible="not pos_display_stock and not pos_restrict_out_of_stock">
                            <label for="pos_stock_type" class="o_light_label me-2"/>
                            <field name="pos_stock_type" widget="radio"/>
                        </div>
                        <div class="row mt8" invisible="not pos_display_stock and not pos_restrict_out_of_stock">
                            <label for="pos_stock_threshold" class="col-lg-4 o_light_label"/>
                            <field name="pos_stock_threshold"/>
                        </div>
                        <div class="mt8" invisible="not pos_display_stock">
                            <field name="pos_hide_out_of_stock_products"/>
                            <label for="pos_hide_out_of_stock_products" class="fw-normal ms-1"/>
                        </div>
                        <div class="mt8" invisible="not pos_restrict_out_of_stock">
                            <field name="pos_allow_manager_override"/>
                            <label for="pos_allow_manager_override" class="fw-normal ms-1"/>
                        </div>
                        <div class="row mt8" invisible="not pos_restrict_out_of_stock">
                            <label for="pos_out_of_stock_message" class="col-lg-4 o_light_label"/>
                            <field name="pos_out_of_stock_message" placeholder="Message shown to cashiers"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
