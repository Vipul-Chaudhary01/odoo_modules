<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_quick_sticky_notes" model="ir.module.category">
        <field name="name">Sticky Notes</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_quick_sticky_notes" model="res.groups.privilege">
        <field name="name">Sticky Notes</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_quick_sticky_notes"/>
    </record>

    <record id="group_quick_sticky_note_user" model="res.groups">
        <field name="name">Sticky Notes User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_quick_sticky_notes"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="quick_sticky_note_own_rule" model="ir.rule">
        <field name="name">Quick sticky notes: own notes only</field>
        <field name="model_id" ref="model_quick_sticky_note"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_quick_sticky_note_user'))]"/>
    </record>
</odoo>
