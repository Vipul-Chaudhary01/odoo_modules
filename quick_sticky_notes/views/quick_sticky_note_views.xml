<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="quick_sticky_note_view_list" model="ir.ui.view">
        <field name="name">quick.sticky.note.list</field>
        <field name="model">quick.sticky.note</field>
        <field name="arch" type="xml">
            <list string="Sticky Notes" default_order="is_pinned desc, sequence, write_date desc" decoration-info="is_pinned">
                <field name="sequence" widget="handle" optional="hide"/>
                <field name="is_pinned" widget="boolean_toggle" string="Pinned"/>
                <field name="name"/>
                <field name="note_scope" string="Type"/>
                <field name="related_record"/>
                <field name="content" optional="hide"/>
                <field name="color" widget="badge"/>
                <field name="create_uid" string="Created By"/>
                <field name="create_date" string="Created On"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="quick_sticky_note_view_form" model="ir.ui.view">
        <field name="name">quick.sticky.note.form</field>
        <field name="model">quick.sticky.note</field>
        <field name="arch" type="xml">
            <form string="Sticky Note">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Note title"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Note">
                            <field name="color"/>
                            <field name="is_pinned"/>
                        </group>
                        <group string="Context">
                            <field name="note_scope" readonly="1"/>
                            <field name="related_record" readonly="1"/>
                            <field name="create_uid" readonly="1" string="Created By"/>
                            <field name="create_date" readonly="1" string="Created On"/>
                            <field name="user_id" readonly="1"/>
                            <field name="res_model" readonly="1" groups="base.group_no_one"/>
                            <field name="res_id" readonly="1" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="content" nolabel="1" placeholder="Write your note here..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="quick_sticky_note_view_kanban" model="ir.ui.view">
        <field name="name">quick.sticky.note.kanban</field>
        <field name="model">quick.sticky.note</field>
        <field name="arch" type="xml">
            <kanban default_order="sequence, write_date desc" class="o_kanban_mobile">
                <field name="name"/>
                <field name="content"/>
                <field name="color"/>
                <field name="is_pinned"/>
                <field name="note_scope"/>
                <field name="related_record"/>
                <field name="create_uid"/>
                <field name="create_date"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card o_quick_sticky_note_kanban o_quick_sticky_notes_color_#{record.color.raw_value}">
                            <div class="o_quick_sticky_note_kanban_header">
                                <strong>
                                    <i t-if="record.is_pinned.raw_value" class="fa fa-thumb-tack me-1" title="Pinned"/>
                                    <field name="name"/>
                                </strong>
                                <span class="badge text-bg-light">
                                    <field name="note_scope"/>
                                </span>
                            </div>
                            <div class="o_quick_sticky_note_kanban_content">
                                <field name="content"/>
                            </div>
                            <div class="o_quick_sticky_note_kanban_footer text-muted">
                                <i class="fa fa-link me-1"/>
                                <field name="related_record"/>
                            </div>
                            <div class="o_quick_sticky_note_kanban_footer text-muted">
                                <i class="fa fa-user me-1"/>
                                <span>Created by </span>
                                <field name="create_uid"/>
                                <span> on </span>
                                <field name="create_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="quick_sticky_note_view_search" model="ir.ui.view">
        <field name="name">quick.sticky.note.search</field>
        <field name="model">quick.sticky.note</field>
        <field name="arch" type="xml">
            <search string="Sticky Notes">
                <field name="name"/>
                <field name="content"/>
                <field name="color"/>
                <field name="create_uid"/>
                <filter name="pinned" string="Pinned" domain="[('is_pinned', '=', True)]"/>
                <filter name="personal_notes" string="Personal Notes" domain="[('res_model', '=', False)]"/>
                <filter name="record_notes" string="Record Notes" domain="[('res_model', '!=', False)]"/>
                <separator/>
                <filter name="group_color" string="Color" context="{'group_by': 'color'}"/>
                <filter name="group_pinned" string="Pinned" context="{'group_by': 'is_pinned'}"/>
                <filter name="group_related_model" string="Related Model" context="{'group_by': 'res_model'}"/>
            </search>
        </field>
    </record>

    <record id="quick_sticky_note_action" model="ir.actions.act_window">
        <field name="name">Sticky Notes</field>
        <field name="res_model">quick.sticky.note</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'default_user_id': uid}</field>
    </record>

    <menuitem id="quick_sticky_note_root_menu"
              name="Sticky Notes"
              action="quick_sticky_note_action"
              parent="mail.menu_root_discuss"
              groups="quick_sticky_notes.group_quick_sticky_note_user"
              sequence="3"/>
</odoo>
